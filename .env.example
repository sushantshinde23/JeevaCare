# GEMINI_API_KEY: Required for server-side Gemini AI features (Copilot, Clinical Warnings, Triage Explanations)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Public Maps Browser API key for Google Maps Platform (@vis.gl/react-google-maps)
# Provisioned via Google Maps Platform or set to your GCP project key.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT=3000

# SUPABASE_URL & SUPABASE_ANON_KEY (Optional if connecting to external Supabase project)
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-key"

